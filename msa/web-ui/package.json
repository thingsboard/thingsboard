{
  "name": "thingsboard-web-ui",
  "private": true,
  "version": "4.4.1",
  "description": "ThingsBoard Web UI Microservice",
  "main": "server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "WEB_FOLDER=./target/web node --watch --watch-preserve-output -r ts-node/register server.ts",
    "start-prod": "WEB_FOLDER=./target/web NODE_ENV=production node --watch --watch-preserve-output -r ts-node/register server.ts",
    "build": "tsc",
    "sbom": "node ../../tools/src/main/javascript/yarn-sbom.js target/sbom/tb-web-ui.cdx.json application --all-platforms"
  },
  "dependencies": {
    "config": "^4.4.2",
    "connect-history-api-fallback": "^2.0.0",
    "express": "^5.3.0",
    "http-proxy": "^1.18.1",
    "js-yaml": "^4.3.2",
    "negotiator": "^1.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "10.3.0",
    "@types/connect-history-api-fallback": "1.5.4",
    "@types/express": "~5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "~22.20.5",
    "@yarnpkg/lockfile": "1.1.0",
    "normalize-package-data": "8.0.0",
    "packageurl-js": "2.0.1",
    "spdx-expression-parse": "4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
