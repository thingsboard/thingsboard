{
  "name": "thingsboard-web-ui",
  "private": true,
  "version": "4.3.1.8",
  "description": "ThingsBoard Web UI Microservice",
  "main": "server.ts",
  "bin": "server.js",
  "scripts": {
    "pkg": "tsc && pkg -t node22-linux-x64 --output ./target/thingsboard-web-ui-linux ./target/src && pkg -t node22-win-x64 --no-bytecode --public-packages \"*\" --public --output ./target/thingsboard-web-ui-win.exe ./target/src && node install.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "WEB_FOLDER=./target/web node --watch --watch-preserve-output -r ts-node/register server.ts",
    "start-prod": "WEB_FOLDER=./target/web NODE_ENV=production node --watch --watch-preserve-output -r ts-node/register server.ts",
    "build": "tsc"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "config": "^4.4.2",
    "connect-history-api-fallback": "^2.0.0",
    "express": "^5.3.0",
    "http-proxy": "^1.18.1",
    "js-yaml": "^4.3.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/connect-history-api-fallback": "1.5.4",
    "@types/express": "~5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "~22.20.5",
    "@yao-pkg/pkg": "^6.24.0",
    "fs-extra": "^11.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "pkg": {
    "assets": [
      "node_modules/config/**/*.*"
    ]
  }
}
