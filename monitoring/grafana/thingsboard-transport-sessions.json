          "editorMode": "code",
          "expr": "sum by (protocol) (thingsboard_transport_connections_active{instance=~\"$instance\"})\nor\nlabel_replace(sum(TRANSPORT_openConnections{instance=~\"$instance\"}), \"protocol\", \"all (legacy)\", \"\", \"\")",
          "legendFormat": "{{protocol}}",
          "refId": "A",
          "range": true,
          "instant": false
