          "editorMode": "code",
          "expr": "(sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=\"MQTTS\"})) / clamp_min(sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=~\"MQTTS?\"}), 1) and sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=~\"MQTTS?\"}) > 0",
          "legendFormat": "MQTT",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "(sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=\"COAPS\"})) / clamp_min(sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=~\"COAPS?\"}), 1) and sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=~\"COAPS?\"}) > 0",
          "legendFormat": "CoAP",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "(sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=\"LWM2M_DTLS\"})) / clamp_min(sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=~\"LWM2M(_DTLS)?\"}), 1) and sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=~\"LWM2M(_DTLS)?\"}) > 0",
          "legendFormat": "LwM2M",
          "refId": "C",
          "range": true,
          "instant": false
