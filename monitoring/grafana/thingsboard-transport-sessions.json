          "editorMode": "code",
          "expr": "sum(rate(thingsboard_transport_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
