      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "expr": "(sum(thingsboard_transport_connections_active{instance=~\"$instance\", protocol=~\"MQTTS|COAPS|LWM2M_DTLS\"})) / clamp_min(sum(thingsboard_transport_connections_active{instance=~\"$instance\"}), 1)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request rate",
      "description": "Requests per second over HTTP and CoAP transports.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
