// Decode an uplink message from a buffer
// payload - array of bytes
// metadata - key/value object

/** Decoder **/

// decode payload to JSON
var data = decodeToJson(payload);

// --- MQTT topic configuration ---

// Supported MQTT topic formats:
// tb/devices/{deviceType}/{deviceName}
// tb/devices/{deviceType}/{deviceName}/telemetry
// tb/sensors/{deviceType}/{deviceName}
// tb/sensors/{deviceType}/{deviceName}/telemetry
//
// Adjust these prefixes to match your MQTT topic layout.
// Each prefix must consist of exactly two topic levels, e.g. "factory/devices":
// {prefix}/{deviceType}/{deviceName}[/telemetry]
var topicPrefixes = ["tb/devices", "tb/sensors"];

// --- Device name and type ---

var topic = metadata != null ? metadata['topic'] : null;

var topicParts = typeof topic === 'string'
    ? topic.split('/')
    : null;

// Validate the supported topic structure.
var validTopic = topicParts != null &&
    (topicParts.length === 4 || topicParts.length === 5) &&
    topicPrefixes.indexOf(topicParts[0] + "/" + topicParts[1]) !== -1 &&
    topicParts[2] !== '' &&
    topicParts[3] !== '' &&
    (topicParts.length === 4 || topicParts[4] === 'telemetry');

// Prefer device information from the payload.
// Otherwise, extract it from the MQTT topic.
// If neither provides deviceType, it falls back to 'default'.
var deviceName = data.deviceName != null &&
    String(data.deviceName).trim() !== ''
    ? data.deviceName
    : (validTopic ? topicParts[3] : null);

var deviceType = data.deviceType != null &&
    String(data.deviceType).trim() !== ''
    ? data.deviceType
    : (validTopic ? topicParts[2] : 'default');

// Reject messages without a valid device name.
if (deviceName == null || String(deviceName).trim() === '') {
    throw new Error('Device name is missing. Provide deviceName in the payload or use a supported MQTT topic format.');
}

// var customerName = 'Customer C';
// var groupName = 'thermostat devices';

// use assetName and assetType instead of deviceName and deviceType
// to automatically create assets instead of devices.
// var assetName = 'Asset A';
// var assetType = 'building';

// --- Timestamp parsing ---
// ts - Unix time in milliseconds (seconds are not converted).
// timestamp - ISO 8601 string, used only when ts is missing.
// If neither is provided, the current time is used.
var timestamp = -1;
if (data.ts != null) {
    timestamp = data.ts;
} else if (data.timestamp != null) {
    timestamp = new Date(data.timestamp).getTime();
}
if (timestamp == -1) {
    timestamp = Date.now();
}

// --- Telemetry and attributes ---
var telemetry = {};

// Keys from the payload that should be stored as attributes instead of telemetry
var attributeKeyList = ["serialNumber"];

// Add the payload keys that match the attribute key list to attributes
var attributes = {};
for (var i = 0; i < attributeKeyList.length; i++) {
    var attributeKey = attributeKeyList[i];
    if (data[attributeKey] != null) {
        attributes[attributeKey] = data[attributeKey];
    }
}

// Keys to exclude from telemetry (device info, attributes and non-telemetry fields)
var excludeFromTelemetryList = ["deviceName", "deviceType", "ts", "timestamp"].concat(attributeKeyList);

// Parse all remaining JSON fields as telemetry
toFlatMap(data, telemetry, excludeFromTelemetryList);

// Result object with device attributes/telemetry data
var result = {
   deviceName: deviceName,
   deviceType: deviceType,
// customerName: customerName,
// groupName: groupName,
// assetName: assetName,
// assetType: assetType,
};

// Add attributes to the result only if at least one matching key was found
if (Object.keys(attributes).length > 0) {
   result.attributes = attributes;
}

result.telemetry = {
   ts: timestamp,
   values: telemetry
};

/** Helper functions **/

function decodeToString(payload) {
   return String.fromCharCode.apply(String, payload);
}

function decodeToJson(payload) {
   var str = decodeToString(payload);
   return JSON.parse(str);
}

function toFlatMap(obj, result, excludeList, prefix) {
    prefix = prefix || '';
    for (var key in obj) {
        if (excludeList.indexOf(key) !== -1) continue;
        var value = obj[key];
        var fullKey = prefix ? prefix + '.' + key : key;
        if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
            toFlatMap(value, result, excludeList, fullKey);
        } else {
            result[fullKey] = value;
        }
    }
}

return result;
