/** Decoder **/

// Decode payload to json
var json = decodeToJson(payload);

// Set general device information
var deviceName = 'Sigfox-' + json.device;
var deviceType = 'Sigfox device';
var groupName = 'Control room devices';
// var customerName = 'Customer A';
// use assetName and assetType instead of deviceName and deviceType
// to automatically create assets instead of devices.
// var assetName = 'Asset A';
// var assetType = 'building';

// Byte 0: configuration flags and firmware version
var attrByte = parseInt(json.data.substring(0, 2), 16);
var autoCalibration = (attrByte & 0x1) === 1 ? "on" : "off";
var zeroPointAdjusted = ((attrByte & 0x2) >> 1) === 1;
var transmitPower = ((attrByte & 0x4) >> 2) === 1 ? "full" : "low";
var powerControl = ((attrByte & 0x8) >> 3) === 1 ? "on" : "off";
var firmwareVersion = attrByte >> 4;

var data = json.data;

var temperature = null;
var humidity = null;
var co2 = null;
var co2Baseline = null;

if (data != null) {
  // Bytes 1–2: temperature, value / 10 - 40 °C
  if (data.length >= 6) {
    temperature = Math.round((parseInt(data.substring(2, 6), 16) / 10.0 - 40) * 10) / 10;
  }
  // Byte 3: humidity
  if (data.length >= 8) {
    humidity = parseInt(data.substring(6, 8), 16);
  }
  // Bytes 4–5: CO2
  if (data.length >= 12) {
    co2 = parseInt(data.substring(8, 12), 16);
  }
  // Byte 6: CO2 baseline, 0 means 400 ppm
  if (data.length >= 14) {
    var co2BaselineN = parseInt(data.substring(12, 14), 16);
    co2Baseline = co2BaselineN === 0 ? 400 : co2BaselineN * 10;
  }
}

var result = {
    // Use deviceName and deviceType or assetName and assetType, but not both.
    deviceName: deviceName,
    deviceType: deviceType,
//  assetName: assetName,
//  assetType: assetType,
//  customerName: customerName,
    groupName: groupName,
    attributes: {
        sigfoxId: json.device,
        deviceTypeId: json.deviceTypeId,
        autoCalibration: autoCalibration,
        zeroPointAdjusted: zeroPointAdjusted,
        transmitPower: transmitPower,
        powerControl: powerControl,
        fwVersion: firmwareVersion
    },
    telemetry: {
        // Sigfox sends time in seconds; ThingsBoard expects milliseconds
        ts: json.time + "000",
        values: {
            temperature: temperature,
            humidity: humidity,
            co2: co2,
            co2Baseline: co2Baseline,
            customData1: json["customData#int1"],
            customData2: json["customData#int2"]
        }
    }
};

/** Helper functions **/

function decodeToString(payload) {
   return String.fromCharCode.apply(String, payload);
}

function decodeToJson(payload) {
   var str = decodeToString(payload);
   return JSON.parse(str);
}

return result;
