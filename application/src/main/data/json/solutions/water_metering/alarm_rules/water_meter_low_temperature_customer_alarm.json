{
  "entityId": {
    "entityType": "DEVICE_PROFILE",
    "id": "58183d7e-4b7a-4ad6-a476-5d6c6571174c"
  },
  "type": "ALARM",
  "name": "Low Temperature Customer Alarm",
  "debugSettings": {
    "failuresEnabled": true,
    "allEnabled": false,
    "allEnabledUntil": 0
  },
  "configurationVersion": 0,
  "configuration": {
    "type": "ALARM",
    "arguments": {
      "cLowTempThreshold": {
        "refDynamicSourceConfiguration": {
          "type": "CURRENT_OWNER"
        },
        "refEntityKey": {
          "key": "cLowTempThreshold",
          "type": "ATTRIBUTE",
          "scope": "SERVER_SCOPE"
        },
        "defaultValue": "1000.0"
      },
      "temperature": {
        "refEntityKey": {
          "key": "temperature",
          "type": "TS_LATEST"
        }
      },
      "cLowTempAlarmEnabled": {
        "refDynamicSourceConfiguration": {
          "type": "CURRENT_OWNER"
        },
        "refEntityKey": {
          "key": "cLowTempAlarmEnabled",
          "type": "ATTRIBUTE",
          "scope": "SERVER_SCOPE"
        },
        "defaultValue": "false"
      }
    },
    "createRules": {
      "WARNING": {
        "condition": {
          "type": "SIMPLE",
          "expression": {
            "type": "SIMPLE",
            "filters": [
              {
                "argument": "cLowTempAlarmEnabled",
                "valueType": "BOOLEAN",
                "operation": "AND",
                "predicates": [
                  {
                    "type": "BOOLEAN",
                    "operation": "EQUAL",
                    "value": {
                      "staticValue": true,
                      "dynamicValueArgument": null
                    }
                  }
                ]
              },
              {
                "argument": "temperature",
                "valueType": "NUMERIC",
                "operation": "AND",
                "predicates": [
                  {
                    "type": "NUMERIC",
                    "operation": "LESS_OR_EQUAL",
                    "value": {
                      "staticValue": null,
                      "dynamicValueArgument": "cLowTempThreshold"
                    }
                  }
                ]
              }
            ],
            "operation": "AND"
          },
          "schedule": null
        },
        "alarmDetails": "${temperature}",
        "dashboardId": null
      }
    },
    "clearRule": null,
    "propagate": false,
    "propagateToOwner": false,
    "propagateToTenant": false,
    "propagateRelationTypes": null,
    "output": null
  }
