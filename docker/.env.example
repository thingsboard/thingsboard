# Copy to .env and adjust.
# cp .env.example .env

# Absolute (or relative to docker/) path to your thingsboard checkout.
# Default ".." assumes this docker/ folder lives inside the repo root.
TB_REPO_PATH=..

# --- Postgres ---
POSTGRES_DB=thingsboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend ports (ui-ngx expects 8080) ---
TB_HTTP_PORT=8080
TB_MQTT_PORT=1883
TB_COAP_PORT=5683
TB_TRANSPORT_PORT=7070
TB_DEBUG_PORT=5005

# --- Behaviour ---
# Install demo data on first install
TB_LOAD_DEMO=true
# Set to true for ONE start to wipe + reinstall the schema
TB_FORCE_REINSTALL=false
# Set to true for ONE start to force a full maven rebuild
TB_FORCE_BUILD=false
# Auto-restart the JVM when compiled classes change
TB_WATCH=true
TB_WATCH_INTERVAL=2
# JVM
TB_JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC
# y = wait for a debugger before starting
TB_DEBUG_SUSPEND=n
