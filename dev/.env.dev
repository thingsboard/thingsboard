# Konfiguracja dev stacku ThingsBoard.
# Skopiuj/edytuj wedle potrzeb - plik jest czytany przez ./dev/up.sh

# porty na hoscie
UI_PORT=4200
TB_HTTP_PORT=8080
TB_DEBUG_PORT=5005
POSTGRES_PORT=5432
CASSANDRA_PORT=9042
KAFKA_PORT=9094
VALKEY_PORT=6379

# baza
POSTGRES_PASSWORD=postgres

# obrazy uzywane tylko do jednorazowego installa schematu i (opcjonalnie) js-executora
DOCKER_REPO=thingsboard
TB_NODE_DOCKER_NAME=tb-node
JS_EXECUTOR_DOCKER_NAME=tb-js-executor
TB_VERSION=4.3.0
LOAD_DEMO=true

# Maven offline po pierwszym buildzie (znacznie szybszy restart backendu)
TB_DEV_OFFLINE=true

# Angular
NG_CONFIGURATION=fast
# ustaw true TYLKO gdy zrodla leza na bind-mouncie Windows (\\wsl$, /mnt/c) lub macOS
NG_POLL=false
