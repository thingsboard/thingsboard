# Angular 20 dev server dla ThingsBoard.
# Kod jest bind-mountowany, node_modules i .angular/cache leza w wolumenach nazwanych.

FROM node:22-bookworm-slim

ENV LANG=C.UTF-8 \
    NG_CLI_ANALYTICS=false \
    CHOKIDAR_USEPOLLING=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 make g++ curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY dev/ui-dev-entrypoint.sh /usr/local/bin/ui-dev-entrypoint.sh
COPY ui-ngx/proxy.conf.dev.js /opt/tb/proxy.conf.dev.js
RUN chmod +x /usr/local/bin/ui-dev-entrypoint.sh

EXPOSE 4200

ENTRYPOINT ["/usr/local/bin/ui-dev-entrypoint.sh"]
