# Backend ThingsBoard w trybie dev: Java 25 + Maven + hot-reload.
# Obraz NIE zawiera kodu - kod jest bind-mountowany z hosta, a ~/.m2 i target
# leza w wolumenach nazwanych. Rebuild kontenera nie jest potrzebny po zmianie kodu.

FROM maven:3.9-eclipse-temurin-25

ENV LANG=C.UTF-8 \
    MAVEN_CONFIG=/root/.m2 \
    TZ=UTC

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl netcat-openbsd \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY dev/tb-node-dev-entrypoint.sh /usr/local/bin/tb-node-dev-entrypoint.sh
RUN chmod +x /usr/local/bin/tb-node-dev-entrypoint.sh

EXPOSE 8080 5005 1883 5683/udp

ENTRYPOINT ["/usr/local/bin/tb-node-dev-entrypoint.sh"]
