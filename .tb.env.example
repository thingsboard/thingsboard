# NAO PREENCHA ESTE ARQUIVO. Ele e rastreado pelo git.
# Copie para .tb.env (que esta no .gitignore) e preencha la:
#     PowerShell:  Copy-Item .tb.env.example .tb.env ; notepad .tb.env
#
# Usado por scripts/tb.mjs. Prefira um usuario tecnico com role restrita,
# nao credencial de admin humano.
TB_URL=https://thingsboard.exemplo.com
TB_USER=integracao@exemplo.com
TB_PASSWORD=

# Descomente so para instancia interna com certificado self-signed.
# Desliga a validacao de TLS do Node no processo inteiro.
#TB_INSECURE=1
