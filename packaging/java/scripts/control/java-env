if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    javaexe="$JAVA_HOME/bin/java"
else
    javaexe=java
fi

require_java() {
    local javaVersion javaMajor
    javaVersion=$(JAVA_TOOL_OPTIONS= JDK_JAVA_OPTIONS= "$1" -version 2>&1 | sed -n 's/.*version "\([^"]*\)".*/\1/p' | head -n 1)
    javaMajor=$(echo "$javaVersion" | sed -e 's/^1\.//' -e 's/^\([0-9]*\).*/\1/')
    if [ -z "$javaMajor" ] || [ "$javaMajor" -lt ${pkg.minJavaVersion} ]; then
        echo "${pkg.name} requires Java ${pkg.minJavaVersion} or later, but '$1' is ${javaVersion:-not a working Java}." >&2
        echo "Select Java ${pkg.minJavaVersion} or later with 'update-alternatives --config java' (deb) or 'alternatives --config java' (rpm), or set JAVA_HOME in $CONF_FOLDER/${pkg.name}.conf." >&2
        exit 78
    fi
}
