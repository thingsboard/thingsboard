[ -z "$CONF_FOLDER" ] && CONF_FOLDER=${pkg.installFolder}/conf
jarfile=${pkg.installFolder}/bin/${pkg.name}.jar

[ -r "$CONF_FOLDER/${pkg.name}.conf" ] && source "$CONF_FOLDER/${pkg.name}.conf"

javaenv=${pkg.installFolder}/bin/java-env
if [ ! -r "$javaenv" ]; then
    echo "Cannot read $javaenv; reinstall ${pkg.name}." >&2
    exit 1
fi
source "$javaenv"

require_java "$javaexe"

cd "$(dirname "$jarfile")" || exit 1
exec "$javaexe" $JAVA_OPTS -jar "$jarfile" $RUN_ARGS "$@"
