// The Things Stack adds decoded_payload for a device registered from the LoRaWAN Device Repository, and the payload
// is then that JSON: its keys become telemetry. A Milesight-style history list keeps each record's time.
// Such a device gets the profile <brand_id>-<model_id>, so all devices of one model share it,
// or the name the integration metadata gives it under profile.<brand_id>-<model_id>. Any other device gets LoRaWAN Device.

// Lansitec: the LoRaWAN Device Repository codecs wrap everything in "bytes", write numbers as strings with units
// ("85%", "-67dBm") and get some fields wrong. Key names follow the Lansitec datasheets where there are any:
// Bluetooth Gateway DataSheet 2.27, Badge Tracker DataSheet v5.30, Temperature Humidity Sensor DataSheet 1.26.
// The wrong fields are decoded from the raw bytes (metadata.data). Remove a fix when the Repository fixes the codec.
var LANSITEC_UNITS = ['dBm', 'dB', '%', 'V', 'sec', 'min', 's', '℃', 'level', ' meter'];

var LANSITEC_GATEWAYS = ['compact-bluetooth-gateway', 'indoor-bluetooth-gateway', 'macro-bluetooth-gateway', 'solar-bluetooth-gateway'];

// Codec key -> datasheet name, per model group. '-' drops the key.
//
// Bluetooth Gateway DataSheet 2.27, 4.4.1 Registration: ADR, Mode (current working LoRaWAN frequency sub-band plan),
// LoRaWAN frequency band, Power (LoRa TX power, dBm), Continuously BLE receiving, DR (LoRaWAN Uplink Data Rate),
// PRI (Position report interval), HB (Heartbeat interval), Bluetooth receiving duration.
// 4.4.2 Heartbeat: RSSI and SNR (LoRa), VER (Firmware version). VOL, SNR and CHGSTAT come from the raw bytes.
// number is the count of reported devices: the beacons list has them. The beacons come from the raw bytes too.
var LANSITEC_GATEWAY_KEYS = {
    adr: 'adr', mode: 'mode', LoRaWANband: 'loraWanFrequencyBand', LoRaTxpower: 'loraTxPower',
    ContinuousReceive: 'continuousBleReceiving', dr: 'dataRate', pos: 'positionReportInterval',
    hb: 'heartbeatInterval', BLEReceivingDuration: 'bluetoothReceivingDuration',
    rssi: 'loraRssi', snr: '-', ver: 'deviceFirmwareVersion', vol: '-', chgstate: '-', number: '-'
};

// Badge Tracker DataSheet v5.30, 5.1 Registration: ADR, LoRa TX power, DR, GNSSEN (GNSS enable status),
// POSMODE (Positioning report mode), BLEPRI (Bluetooth Position Report Interval). The codec reads it without the
// GNSSPRI field, so heartbeat, version, CFMMSG, HBCOUNT and fall detection come from the raw bytes.
// 5.2 Heartbeat: Battery (percentage), RSSI (LoRa), GNSSSTATE (Status of the GNSS module), CHGSTATE (Status of
// battery charging). SNR and VIBSTATE come from the raw bytes.
// 5.3 GNSS Position: longitude, latitude and time come from the raw bytes.
// 5.4 Beacon: bytes 1-5 are RFU, the codec reads byte 1 as Vibstate. 5.5 Alarm: 0x01 SOS, 0x02 Fall Detection.
var LANSITEC_BADGE_KEYS = {
    ADR: 'adr', 'Lora Txpower': 'loraTxPower', DR: 'dataRate', GNSSEN: 'gnssEnabled',
    'Position mode': 'positioningReportMode', 'Position period': 'bluetoothPositionReportInterval',
    'Heartbeat period': '-', 'Firmware version': '-', CFMMSG: '-', HBCOUNT: '-', 'Fall threshold': '-',
    'Battery level': 'batteryLevel', RSSI: 'loraRssi', SNR: '-', 'GPS state': 'gnssState',
    'Move state': '-', 'Charge state': 'chargeState',
    Longitude: '-', Latitude: '-', Time: '-', Length: '-', Vibstate: '-', 'Alarm type': 'alarm'
};

// Temperature Humidity Sensor DataSheet 1.26, 2.2.1 Register: ADR, MODE (current working scheme), SMODE (data
// scheme supported), POWER (configured transmit power, dBm), DR, REPTIND (report H&T if the value is the same;
// the codec gives "false" for 0 = always report), TH (period of temperature and humidity report), CRC.
// 2.2.2 Periodical temperature and humidity: VER is the version of the message type, not the firmware;
// VOL (battery left, %), RSSI (downlink, detected by the sensor). SNR, temperature and humidity come from the raw bytes.
var LANSITEC_TEMPERATURE_HUMIDITY_KEYS = {
    adr: 'adr', mode: 'mode', smode: 'smode', LoraTxpower: 'loraTxPower', dr: 'dataRate', repting: 'reptind',
    th: 'temperatureHumidityReportPeriod', crc: '-',
    ver: '-', vol: 'batteryLevel', rssi: 'loraRssi', snr: '-', temperature: '-', humidity: '-'
};

// Without a datasheet only these keys are renamed: the integration writes rssi, snr and firmwareVersion itself.
// chgstate: the SocketSync gateway has the compact gateway codec byte for byte, which reads CHGSTAT 0x50 as
// "Not charging" (Bluetooth Gateway DataSheet 2.27, 4.4.2), so it is dropped. number is its count of reported
// devices: the beacons list has them.
var LANSITEC_CLASH_KEYS = {
    rssi: 'loraRssi', RSSI: 'loraRssi', snr: 'loraSnr', SNR: 'loraSnr',
    firmwareVersion: 'deviceFirmwareVersion', 'Firmware version': 'deviceFirmwareVersion',
    type: '-', 'Message type': '-', chgstate: '-', number: '-'
};

// Beacon keys: Devicetype1data1, Device1data, dev1major, dev1.major, pos1minor, asset1rssi...
var LANSITEC_BEACON_PREFIXES = ['devicetype1', 'devicetype2', 'devicetype3', 'device', 'dev', 'pos', 'asset'];
var LANSITEC_BEACON_FIELDS = ['data', 'major', 'minor', 'rssi', 'id'];

function lansitecEndsWith(s, end) {
    return s.length >= end.length && s.substring(s.length - end.length) == end;
}

// Strips the unit. Periods become seconds: the codecs give most of them in seconds, a few in minutes.
function lansitecNumber(v) {
    if (typeof v != 'string') {
        return v;
    }
    for (var i = 0; i < LANSITEC_UNITS.length; i++) {
        var u = LANSITEC_UNITS[i];
        if (lansitecEndsWith(v, u)) {
            var n = v.substring(0, v.length - u.length).trim();
            if (/^-?[0-9]+(\.[0-9]+)?$/.test(n)) {
                return u == 'min' ? parseFloat(n) * 60 : parseFloat(n);
            }
        }
    }
    return v;
}

function lansitecLowerStart(part) {
    var n = 0;
    while (n < part.length && part.charAt(n) != part.charAt(n).toLowerCase()) {
        n = n + 1;
    }
    if (n == part.length) {
        return part.toLowerCase();
    }
    if (n > 1) {
        return part.substring(0, n - 1).toLowerCase() + part.substring(n - 1);
    }
    return part.substring(0, 1).toLowerCase() + part.substring(1);
}

function lansitecCamelCase(key) {
    var parts = key.split(/[ .]+/);
    var result = lansitecLowerStart(parts[0]);
    for (var i = 1; i < parts.length; i++) {
        var part = lansitecLowerStart(parts[i]);
        result = result + part.substring(0, 1).toUpperCase() + part.substring(1);
    }
    return result;
}

function lansitecBeaconKey(key) {
    var k = key.toLowerCase().replace('.', '');
    for (var i = 0; i < LANSITEC_BEACON_PREFIXES.length; i++) {
        var p = LANSITEC_BEACON_PREFIXES[i];
        if (k.indexOf(p) == 0) {
            var rest = k.substring(p.length);
            for (var j = 0; j < LANSITEC_BEACON_FIELDS.length; j++) {
                var f = LANSITEC_BEACON_FIELDS[j];
                if (lansitecEndsWith(rest, f) && /^[0-9]+$/.test(rest.substring(0, rest.length - f.length))) {
                    return { group: p, index: rest.substring(0, rest.length - f.length), field: f };
                }
                if (rest.indexOf(f) == 0 && /^[0-9]+$/.test(rest.substring(f.length))) {
                    return { group: p, index: rest.substring(f.length), field: f };
                }
            }
        }
    }
    return null;
}

function lansitecKeyTable(model) {
    if (LANSITEC_GATEWAYS.indexOf(model) >= 0) {
        return LANSITEC_GATEWAY_KEYS;
    }
    if (model == 'badge-tracker') {
        return LANSITEC_BADGE_KEYS;
    }
    if (model == 'temperature-humidity-sensor') {
        return LANSITEC_TEMPERATURE_HUMIDITY_KEYS;
    }
    return null;
}

function lansitecValues(raw, model) {
    var table = lansitecKeyTable(model);
    var values = {};
    var beacons = {};
    Object.keys(raw).forEach(function (key) {
        var value = raw[key];
        var b = lansitecBeaconKey(key);
        if (b != null) {
            var id = b.group + b.index;
            if (beacons[id] == null) {
                beacons[id] = { order: parseInt(b.index, 10) };
            }
            if (b.field == 'rssi') {
                beacons[id].rssi = lansitecNumber(value);
            } else if (b.field == 'data' || b.field == 'major' || b.field == 'minor') {
                beacons[id][b.field] = value;
            }
        } else if (table == null && key == 'time' && typeof value == 'string') {
            // Container tracker and helmet sensor, no datasheet: their codecs add 8 hours to the GNSS time and wrap
            // it in quotes, as the badge tracker codec does with the UTC time of DataSheet v5.30, 5.3.
            values.gnssTime = new Date(value.replace(/"/g, '')).getTime() - 8 * 60 * 60 * 1000;
        } else if (table != null && table.hasOwnProperty(key)) {
            if (table[key] != '-') {
                values[table[key]] = lansitecNumber(value);
            }
        } else if (LANSITEC_CLASH_KEYS.hasOwnProperty(key)) {
            if (LANSITEC_CLASH_KEYS[key] != '-') {
                values[LANSITEC_CLASH_KEYS[key]] = lansitecNumber(value);
            }
        } else {
            values[lansitecCamelCase(key)] = lansitecNumber(value);
        }
    });
    if (Object.keys(beacons).length > 0) {
        values.beacons = lansitecBeaconList(beacons);
    }
    return values;
}

function lansitecBeaconList(beacons) {
    var list = [];
    var ids = Object.keys(beacons);
    for (var i = 1; i <= ids.length; i++) {
        ids.forEach(function (id) {
            var b = beacons[id];
            if (b.order == i) {
                var item = {};
                if (b.data != null) {
                    item.data = b.data;
                }
                if (b.major != null) {
                    item.major = b.major;
                    item.minor = b.minor;
                }
                item.rssi = b.rssi;
                list.push(item);
            }
        });
    }
    // The gateway codec reads the data of every device after the first at a 5-byte step, so it is right only
    // for 4-byte data (DataSheet 4.4.4 examples): with longer data only the first device is kept. The gateways
    // with a datasheet get their beacons from the raw bytes instead; this is for the SocketSync gateway.
    if (list.length > 1 && list[0].data != null && list[0].data.length != 8) {
        return [list[0]];
    }
    return list;
}

// Decoded from the raw bytes by the datasheet where the codec gets it wrong.
function lansitecRawValues(values, b, model) {
    var type = (b[0] >> 4) & 0x0F;
    if (LANSITEC_GATEWAYS.indexOf(model) >= 0) {
        lansitecGatewayRawValues(values, b, model, type);
    } else if (model == 'badge-tracker') {
        lansitecBadgeRawValues(values, b, type);
    } else if (model == 'temperature-humidity-sensor' && type == 2) {
        lansitecTemperatureHumidityRawValues(values, b);
    }
}

function lansitecBase64ToBytes(input) {
    var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    var bytes = [];
    var bits = 0;
    var count = 0;
    for (var i = 0; i < input.length; i++) {
        var c = chars.indexOf(input.charAt(i));
        if (c < 0) {
            continue;
        }
        bits = (bits << 6) | c;
        count = count + 6;
        if (count >= 8) {
            count = count - 8;
            bytes.push((bits >> count) & 0xFF);
        }
    }
    return bytes;
}

function lansitecHex(b, from, to) {
    var digits = '0123456789ABCDEF';
    var hex = '';
    for (var i = from; i < to; i++) {
        hex = hex + digits.charAt((b[i] >> 4) & 0x0F) + digits.charAt(b[i] & 0x0F);
    }
    return hex;
}

function lansitecUint(b, offset, length) {
    var v = 0;
    for (var i = 0; i < length; i++) {
        v = v * 256 + b[offset + i];
    }
    return v;
}

// IEEE 754 single precision, big-endian, rounded to 6 decimals (about 0.1 m) as in the TBEL converter.
function lansitecFloat(b, offset) {
    var bits = lansitecUint(b, offset, 4);
    var exponent = Math.floor(bits / 8388608) % 256;
    var mantissa = bits % 8388608;
    var value = exponent == 0 ? mantissa * Math.pow(2, -149) : (1 + mantissa / 8388608) * Math.pow(2, exponent - 127);
    value = Math.round(value * 1000000) / 1000000;
    return bits >= 2147483648 ? -value : value;
}

// SNR, unit 0.01 dB, -3000 to 3000: signed. The codecs read it unsigned.
function lansitecSnr(b, offset) {
    var v = lansitecUint(b, offset, 2);
    if (v > 32767) {
        v = v - 65536;
    }
    return v / 100;
}

// Bluetooth Gateway DataSheet 2.27.
function lansitecGatewayRawValues(values, b, model, type) {
    if (type == 1 && b.length >= 9) {
        // 4.4.1: Network reconnection interval, unit 5 minutes. The codec does not decode it.
        values.networkReconnectionInterval = b[8] * 300;
    } else if (type == 2 && b.length >= 8) {
        // 4.4.2: VOL is the battery voltage (VOL x 0.01 + 1.5 V) on the macro gateway and the battery level (%) on
        // the others. The codec decides by the value (<= 100 is %), not by the model.
        if (model == 'macro-bluetooth-gateway') {
            values.batteryVoltage = (b[1] + 150) / 100;
        } else {
            values.batteryLevel = b[1];
        }
        values.loraSnr = lansitecSnr(b, 3);
        // CHGSTAT: 0x00 Not charging, 0x50 Charging, 0x60 Charging completed on the compact and solar gateway,
        // always 0x00 on the macro and indoor gateway. The codec reads the low half of the byte.
        if (model == 'compact-bluetooth-gateway' || model == 'solar-bluetooth-gateway') {
            if (b[7] == 0x00) {
                values.chargeState = 'Not charging';
            } else if (b[7] == 0x50) {
                values.chargeState = 'Charging';
            } else if (b[7] == 0x60) {
                values.chargeState = 'Charging completed';
            }
        }
    } else if (type == 0x8 || type == 0x9 || type == 0xA || type == 0xE) {
        delete values.beacons;
        var beacons = lansitecGatewayBeacons(b, type);
        if (beacons != null) {
            values.beacons = beacons;
        }
    }
}

// 4.4.4-4.4.6: Device Type 1, 2 and 3 messages: Type (bits 3-0: number of devices), then Data (1-31 bytes) and
// RSSI (value - 256, dBm) of each device. Data length is not in the message: it is set by the device report rule
// of the type (4.4.3), so all devices of one message have the same length. The codec reads every device after
// the first at a 5-byte step.
// 4.4.7: Multi-Device Type message: Device Type ID before the data of each device. The data length can differ per
// type, and the message does not say it: decoded only when all devices fit the same length.
function lansitecGatewayBeacons(b, type) {
    var count = b[0] & 0x0F;
    if (count == 0 || (b.length - 1) % count != 0) {
        return null;
    }
    var step = (b.length - 1) / count;
    var head = type == 0xE ? 1 : 0;
    var dataLength = step - head - 1;
    if (dataLength < 1) {
        return null;
    }
    var list = [];
    for (var i = 0; i < count; i++) {
        var start = 1 + i * step;
        var deviceType = type - 7;
        if (type == 0xE) {
            deviceType = b[start];
            if (deviceType < 1 || deviceType > 3) {
                return null;
            }
        }
        list.push({
            deviceType: deviceType,
            data: lansitecHex(b, start + head, start + head + dataLength),
            rssi: b[start + step - 1] - 256
        });
    }
    return list;
}

// Badge Tracker DataSheet v5.30.
function lansitecBadgeRawValues(values, b, type) {
    if (type == 1 && b.length == 14) {
        // 5.1, 14 bytes: Type, SMODE, Power, Config, BLEPRI (2), GNSSPRI (2), Heartbeat, Version (2), CFMMSG, HBCOUNT, Fall.
        // BLEEN (Config bit 0) is not decoded: the field table says BLE enable status and that GNSSEN or BLEEN must
        // be enabled, but the example (Config 32) has both 0 and calls bit 0 reserved.
        values.gnssPositionReportInterval = lansitecUint(b, 6, 2) * 5;
        values.heartbeatInterval = b[8] * 30;
        // Version 0x0525 is V5.25.
        var major = lansitecHex(b, 9, 10);
        if (major.charAt(0) == '0') {
            major = major.substring(1);
        }
        values.deviceFirmwareVersion = 'V' + major + '.' + lansitecHex(b, 10, 11);
        values.cfmmsg = b[11];
        values.hbcount = b[12];
        // Fall detection threshold, unit 0.5 m, 0 means off.
        values.fallDetectionThreshold = b[13] * 0.5;
    } else if (type == 2 && b.length >= 6) {
        // 5.2: the SNR field is there since firmware 0x0501. The SNREN bit (Type bits 3-0) is not used: the
        // datasheet example 20 64 3E 033E 00 60 00 has SNREN 0 and the SNR 8.3 dB.
        values.loraSnr = lansitecSnr(b, 3);
        // VIBSTATE: moving state 0-9, 0 means no moving, 9 high acceleration. The codec turns only 0 and 1 into text.
        values.movingState = b[5] & 0x0F;
    } else if (type == 3 && b.length >= 13) {
        // 5.3: Flag (Type bits 3-0) 0x1 means GNSS positioning failed. Longitude and latitude are IEEE 754 floats
        // (the codec divides the mantissa by 0x7fffff instead of 2^23), time is UTC seconds (the codec adds 8 hours).
        if ((b[0] & 0x0F) == 0) {
            values.longitude = lansitecFloat(b, 1);
            values.latitude = lansitecFloat(b, 5);
            values.gnssTime = lansitecUint(b, 9, 4) * 1000;
        }
    }
}

// Temperature Humidity Sensor DataSheet 1.26, 2.2.2: VER (Type bits 3-0) 1 means the SNR field is there, 0 means
// it is not and the message is 8 bytes. The codec always reads the SNR, so with VER 0 the next fields are shifted.
// TEMP_INT bit 7 is the sign, TEMP_FRA the hundredths.
function lansitecTemperatureHumidityRawValues(values, b) {
    var offset = 3;
    if ((b[0] & 0x0F) == 1) {
        values.loraSnr = lansitecSnr(b, 3);
        offset = 5;
    }
    if (b.length < offset + 3) {
        return;
    }
    var temperature = (b[offset] & 0x7F) + b[offset + 1] / 100;
    if ((b[offset] & 0x80) != 0) {
        temperature = -temperature;
    }
    values.temperature = Math.round(temperature * 100) / 100;
    values.humidity = b[offset + 2];
}

var values = {};
var attributes = {};
var history = [];
if (metadata.payloadFormat == 'JSON') {
    values = decodeToJson(payload);
    if (metadata.brandId == 'lansitec' && values.bytes != null) {
        // The Lansitec codecs put everything in "bytes" and get some fields wrong: see the Lansitec block above.
        var raw = values.bytes;
        values = lansitecValues(raw, metadata.modelId);
        if (metadata.data != null) {
            lansitecRawValues(values, lansitecBase64ToBytes(metadata.data), metadata.modelId);
        }
        // Register is sent after join and holds the device settings: they are attributes, not telemetry.
        var messageType = raw.type != null ? raw.type : raw['Message type'];
        if (messageType == 'Register') {
            attributes = values;
            values = {};
        }
    } else if (Array.isArray(values.history)) {
        values.history.forEach(function (record) {
            if (record.timestamp != null) {
                var ts = record.timestamp * 1000;
                delete record.timestamp;
                history.push({ ts: ts, values: record });
            }
        });
        delete values.history;
    }
}
var profile = 'LoRaWAN Device';
if (metadata.brandId != null && metadata.modelId != null) {
    profile = metadata.brandId + '-' + metadata.modelId;
    // The profile name chosen at install, kept in the integration metadata
    var customProfile = metadata['profile.' + profile];
    if (customProfile != null && customProfile != '') {
        profile = customProfile;
    }
}
if (Object.keys(attributes).length > 0) {
    return { profile: profile, attributes: attributes };
}
if (history.length == 0) {
    return { profile: profile, telemetry: { ts: metadata.ts, values: values } };
}
history.push({ ts: metadata.ts, values: values });
return { profile: profile, telemetry: history };

// The payload is UTF-8: a codec value can have a unit like ℃.
function decodeToJson(payload) {
    return JSON.parse(decodeURIComponent(escape(String.fromCharCode.apply(String, payload))));
}
