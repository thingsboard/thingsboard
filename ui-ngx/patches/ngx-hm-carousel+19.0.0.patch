+// ThingsBoard: replaces the helper imported from '@nghedgehog/core', the only thing the carousel used from that package.
+// Runs onResize, then emits, once the size of the element has not changed for the given delay.
+function resizeObservable(element, onResize, delay = 200) {
+    return new Observable((subscriber) => {
+        let timeoutId;
+        const observer = new ResizeObserver(() => {
+            clearTimeout(timeoutId);
+            timeoutId = setTimeout(() => {
+                onResize();
+                subscriber.next();
+            }, delay);
+        });
+        observer.observe(element);
+        return () => {
+            clearTimeout(timeoutId);
+            observer.disconnect();
+        };
+    });
+}
 
