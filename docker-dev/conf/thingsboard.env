# ThingsBoard dev backend configuration (NOT for production).
# Secrets (DB password, Mailtrap password) belong in docker-dev/.env instead.

# --- Database ---------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/thingsboard
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DRIVER_CLASS_NAME=org.postgresql.Driver
DATABASE_TS_TYPE=sql

# --- Single-node dev mode: no Kafka, no Redis -------------------------------
TB_SERVICE_ID=tb-dev-node
TB_SERVICE_TYPE=monolith
TB_QUEUE_TYPE=in-memory
CACHE_TYPE=caffeine

# --- HTTP / WebSocket -------------------------------------------------------
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_BIND_PORT=8080
# WebSocket endpoint for the local Angular app: ws://localhost:8080/api/ws

# --- CORS for a locally served Angular UI (dev only, wide open) -------------
# Applied through SPRING_APPLICATION_JSON so it works regardless of the
# thingsboard.yml version in the repo.
SPRING_APPLICATION_JSON={"spring":{"mvc":{"cors":{"mappings":{"[/**]":{"allowed-origin-patterns":["*"],"allowed-methods":["GET","POST","PUT","PATCH","DELETE","OPTIONS","HEAD"],"allowed-headers":["*"],"exposed-headers":["Authorization","Content-Disposition"],"allow-credentials":true,"max-age":1800}}}}},"server":{"ws":{"send_timeout":5000}}}

# --- Swagger / OpenAPI ------------------------------------------------------
SWAGGER_ENABLED=true
# UI: http://localhost:8080/swagger-ui.html   spec: /v3/api-docs

# --- Mail (Mailtrap sandbox) ------------------------------------------------
MAIL_ENABLED=true
MAIL_SMTP_PROTOCOL=smtp
MAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
MAIL_SMTP_PORT=2525
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SSL_ENABLE=false
MAIL_TIMEOUT=10000
MAIL_FROM=no-reply@localhost
# MAIL_USERNAME / MAIL_PASSWORD come from docker-dev/.env

# --- Security / dev conveniences -------------------------------------------
SECURITY_USER_TOKEN_ACCESS_ENABLED=true
JS_EVALUATOR=local
UPDATES_ENABLED=false
