# Copy to docker-dev/.env and fill in. This file holds the dev secrets.
POSTGRES_PASSWORD=postgres

# Mailtrap sandbox inbox credentials
MAIL_USERNAME=d757b85b30081e
MAIL_PASSWORD=replace-with-your-mailtrap-password

# JVM
JAVA_OPTS=-Xms1g -Xmx3g
MAVEN_OPTS=-Xmx3g
JAVA_DEBUG=true

# Set to false if you do not want ThingsBoard demo data on first install
LOAD_DEMO=true
