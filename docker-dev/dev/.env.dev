# Konfiguracja dev stacku ThingsBoard (Windows 10 + Docker Desktop).
# Plik czytany przez dev/up.ps1, dev/dev.cmd i dev/up.sh

# porty na hoscie
UI_PORT=4200
TB_HTTP_PORT=8080
TB_DEBUG_PORT=5005
POSTGRES_PORT=5432
CASSANDRA_PORT=9042
KAFKA_PORT=9094
VALKEY_PORT=6379

# baza
POSTGRES_PASSWORD=postgres

# obrazy uzywane tylko do jednorazowego installa schematu i (opcjonalnie) js-executora
DOCKER_REPO=thingsboard
TB_NODE_DOCKER_NAME=tb-node
JS_EXECUTOR_DOCKER_NAME=tb-js-executor
TB_VERSION=4.3.0
LOAD_DEMO=true

# ---------------------------------------------------------------- backend
# Maven offline po pierwszym buildzie (znacznie szybszy restart backendu)
TB_DEV_OFFLINE=true
# auto-kompilacja po zapisie pliku .java
TB_DEV_WATCH=true
# devtools | restart | auto  (auto = devtools jesli jest w pom.xml, inaczej restart procesu)
TB_DEV_RELOAD=auto
# na Windows inotify nie przechodzi przez bind-mount - watcher musi pollowac
TB_DEV_WATCH_POLL=true
TB_DEV_WATCH_POLL_INTERVAL=2

# ---------------------------------------------------------------- frontend
NG_CONFIGURATION=fast
# true dla repo na dysku Windows; false gdy repo lezy w systemie plikow WSL2
NG_POLL=true
NG_POLL_INTERVAL=1500
