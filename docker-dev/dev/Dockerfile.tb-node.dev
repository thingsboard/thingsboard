# Backend ThingsBoard w trybie dev: Java 25 + Maven + auto-kompilacja zrodel.
#
# Obraz NIE zawiera kodu - kod jest bind-mountowany z hosta (/src), a ~/.m2 i target
# leza w wolumenach nazwanych. Po zmianie w .java nie trzeba przebudowywac obrazu.

FROM maven:3.9-eclipse-temurin-25

ENV LANG=C.UTF-8 \
    MAVEN_CONFIG=/root/.m2 \
    TZ=UTC

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl netcat-openbsd inotify-tools procps \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY docker-dev/dev/tb-node-dev-entrypoint.sh /usr/local/bin/tb-node-dev-entrypoint.sh
COPY docker-dev/dev/tb-node-watch.sh /usr/local/bin/tb-node-watch.sh
RUN chmod +x /usr/local/bin/tb-node-dev-entrypoint.sh /usr/local/bin/tb-node-watch.sh

EXPOSE 8080 5005 1883 5683/udp

ENTRYPOINT ["/usr/local/bin/tb-node-dev-entrypoint.sh"]
