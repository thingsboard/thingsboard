# Angular 20 dev server dla ThingsBoard (ui-ngx).
# Kod jest bind-mountowany, node_modules i .angular/cache leza w wolumenach nazwanych.
# Repo uzywa yarn.lock, wiec instalacja idzie przez yarn - nie npm.

FROM node:22-bookworm-slim

ENV LANG=C.UTF-8 \
    NG_CLI_ANALYTICS=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      python3 \
      make \
      g++ \
      curl \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable

WORKDIR /app

COPY docker-dev/dev/ui-dev-entrypoint.sh /usr/local/bin/ui-dev-entrypoint.sh
COPY ui-ngx/proxy.conf.dev.js /opt/tb/proxy.conf.dev.js
RUN chmod +x /usr/local/bin/ui-dev-entrypoint.sh

EXPOSE 4200

ENTRYPOINT ["/usr/local/bin/ui-dev-entrypoint.sh"]
